{
  "name": "mtariqsajid/laravel-generator",
  "type": "library",
  "description": "InfyOm Laravel Generator",
  "keywords": [
    "laravel",
    "api",
    "model",
    "request",
    "migration",
    "model",
    "crud",
    "repository",
    "view",
    "test",
    "generator",
    "swagger"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Tariq Sajid",
      "email": "mtariqsajid@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1.0",
    "illuminate/support": "^11.0",
    "illuminate/console": "^11.0",
    "laracasts/flash": "^3.2.2",
    "symfony/var-exporter": "^6.2.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0.7",
    "mockery/mockery": "^1.5.1",
    "orchestra/testbench": "^9.14",
    "pestphp/pest": "^2.36",
    "pestphp/pest-plugin-laravel": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "mtariqsajid\\Generator\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "\\mtariqsajid\\Generator\\InfyOmGeneratorServiceProvider"
      ]
    }
  },
  "funding": [],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
